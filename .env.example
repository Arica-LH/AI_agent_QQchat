# NapCat/OneBot reverse WebSocket connects to this local bridge.
HOST=127.0.0.1
PORT=3001
WS_PATH=/onebot/v11/ws
ONEBOT_ACCESS_TOKEN=replace-with-a-long-random-token

# Fill in your own IDs locally. At least one user/group allowlist is required.
# For private chats, comma-separated QQ numeric IDs allowed to use the bot.
ALLOWED_USER_IDS=
# Comma-separated group IDs allowed to trigger replies.
ALLOWED_GROUP_IDS=
# QQ account logged into NapCat; its own messages are ignored.
BOT_QQ_ID=

# The bridge backend: codex (default), dsh, or official (DeepSeek OpenAI-compatible API).
CHAT_BACKEND=codex
# Required when CHAT_BACKEND=official. Keep this value local and never commit it.
DEEPSEEK_API_KEY=
# Optional official API settings.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=
DEEPSEEK_MAX_TOKENS=4096
# dsh headless profile settings (used when CHAT_BACKEND=dsh).
CHAT_DSH_BIN=dsh
CHAT_DSH_PROFILE=headless
# Optional absolute path to your dsh home; empty uses the dsh default.
CHAT_DSH_HOME=
# Optional overlay from dsh web settings (usually ~/.dsh/profiles/web/cordis.patch.yml).
CHAT_DSH_PATCH=
# The project directory is also dsh's working directory and writable sandbox.
PROJECT_DIR=.
MAX_PROMPT_CHARS=6000
MESSAGE_DEDUP_WINDOW_MS=45000
MESSAGE_BATCH_WINDOW_MS=4000
MESSAGE_IMAGE_BATCH_WINDOW_MS=12000
# Optional Codex model name. Leave empty to use the CLI default model.
CODEX_MODEL=
# Optional reasoning effort: low, medium, high, or xhigh (model-dependent).
CODEX_REASONING_EFFORT=
# Optional Codex executable path and per-request timeout.
CODEX_BIN=codex
CODEX_TIMEOUT_MS=600000

# Default role and personality sent with each user request.
DEFAULT_PERSONA=你是一个友好、理性、可靠的 QQ 助手。请简洁清楚地回答问题，保持事实准确。
